  <report type="UXO/IED">
    <section title="9-Line Explosive Hazard Report" invert="False" role="All">
      <option format="MM dd yyyy HH:mm" type="dateTime" required="true" title="Line 1: Date" />
      <option title="Line 1: Time (UTC)" required="true" type="time" />
      <option title="Line 2: Reporting Activity / Contact" required="true" type="string" />
      <option title="Line 3: Location" required="true" type="geometry" />
      <list title="Line 4: Type of Ordnance" required="true">
        <option title="Dropped (Bomb/Cluster Munition)" required="false" type="string" />
        <option title="Projected (Artillery/Mortar/Rocket)" required="false" type="string" />
        <option title="Placed (IED/Landmine/Booby Trap)" required="false" type="string" />
        <option title="Thrown (Hand Grenade/Improvised Device)" required="false" type="string" />
        <option title="Other / Unidentified" required="false" type="string" />
        <option title="Unknown / Undetermined" required="false" type="string" />
      </list>
      <list title="Line 5: CBRN Contamination" required="true">
        <option title="None / Clear" required="false" type="string" />
        <option title="Suspected CBRN" required="false" type="string" />
        <option title="Confirmed Chemical" required="false" type="string" />
        <option title="Confirmed Biological" required="false" type="string" />
        <option title="Confirmed Radiological" required="false" type="string" />
        <option title="Confirmed Multiple / Mixed CBRN" required="false" type="string" />
