        <option title="Vehicles / Aircraft" required="false" type="string" />
        <option title="Personnel / Civilians" required="false" type="string" />
        <option title="Critical Infrastructure" required="false" type="string" />
        <option title="Other" required="false" type="string" />
        <option title="Unknown / Undetermined" required="false" type="string" />
      </list>
      <option title="Line 7: Impact on Mission" required="true" type="string" />
      <list title="Line 8: Protective Measures Taken" required="true" multiple="true">
        <option title="Personnel / Area Warning" required="false" type="string" />
        <option title="Cordon / Restricted Access" required="false" type="string" />
        <option title="Evacuation" required="false" type="string" />
        <option title="Standardized Marking" required="false" type="string" />
        <option title="Improvised Marking" required="false" type="string" />
        <option title="No Protective Measures Taken" required="false" type="string" />
        <option title="Other" required="false" type="string" />
        <option title="Unknown / Undetermined" required="false" type="string" />
      </list>
      <option title="Protective Measures / Additional Details" required="false" type="string" />
